PORT=5000

# Supabase project URL (from: Project Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — from Project Settings → API → anon/public key
SUPABASE_ANON_KEY=your-publishable-key-here

SUPABASE_STORAGE_BUCKET=missing-person-files
FRONTEND_URL=http://localhost:3000
